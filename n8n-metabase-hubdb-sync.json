    {
      "parameters": {
        "method": "GET",
        "url": "https://api.hubapi.com/cms/v3/hubdb/tables/224700702/rows/draft",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "1000"
            }
          ]
        }
      },
      "id": "get-hubdb-bairro",
      "name": "HubDB Bairro: Buscar Linhas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 600],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "HubSpot API"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByFields",
        "mergeByFields": {
          "values": [
            {
              "field1": "Bairro",
              "field2": "Bairro"
            }
          ]
        },
        "joinMode": "keepEverything",
        "options": {}
      },
      "id": "merge-bairro-prot-ind",
      "name": "Bairro: Merge Protegidos + Indiciados",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [600, 100]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByFields",
        "mergeByFields": {
          "values": [
            {
              "field1": "Bairro",
              "field2": "Bairro"
            }
          ]
        },
        "joinMode": "keepEverything",
        "options": {}
      },
      "id": "merge-bairro-completo",
      "name": "Bairro: Merge Dados Completos",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [900, 200]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n  return {\n    json: {\n      bairro: data['Bairro'] || data['bairro'] || '',\n      indiciados: Number(data['Valores distintos de IDDesfecho'] || data['valores distintos de iddesfecho']) || 0,\n      protegidos: Number(data['Soma de QtdProtegidos'] || data['soma de qtdprotegidos']) || 0,\n      ocorrencias: Number(data['Contagem'] || data['contagem']) || 0\n    }\n  };\n}).filter(item => item.json.bairro !== '');"
      },
      "id": "normalizar-bairro",
      "name": "Bairro: Normalizar Colunas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "mode": "chooseBranch",
        "output": "empty"
      },
      "id": "merge-aguardar-bairro",
      "name": "Bairro: Aguardar Metabase + HubDB",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1500, 300]
    },
    {
      "parameters": {
        "jsCode": "const metabaseData = $('Bairro: Normalizar Colunas').all();\nconst hubdbResponse = $('HubDB Bairro: Buscar Linhas').all();\n\nconst hubdbRows = hubdbResponse[0]?.json?.results || hubdbResponse[0]?.json?.objects || [];\n\nconst bairroToRowId = {};\nfor (const row of hubdbRows) {\n  const bairroValue = row.values?.bairro || row.values?.Bairro || '';\n  if (bairroValue) {\n    bairroToRowId[bairroValue.toString().toLowerCase().trim()] = row.id;\n  }\n}\n\nconst output = [];\nfor (const item of metabaseData) {\n  const bairro = (item.json.bairro || '').toString().toLowerCase().trim();\n  const rowId = bairroToRowId[bairro];\n\n  if (rowId) {\n    output.push({\n      json: {\n        rowId: rowId,\n        bairro: item.json.bairro,\n        indiciados: item.json.indiciados,\n        protegidos: item.json.protegidos,\n        ocorrencias: item.json.ocorrencias\n      }\n    });\n  }\n}\n\nreturn output;"
      },
      "id": "mapear-bairro-rowid",
      "name": "Bairro: Mapear → Row ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 300]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://api.hubapi.com/cms/v3/hubdb/tables/224700702/rows/{{ $json.rowId }}/draft",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"values\": {\n    \"bairro\": \"{{ $json.bairro }}\",\n    \"protegidos\": \"{{ Math.ceil($json.protegidos) }}\",\n    \"indiciados\": \"{{ Math.ceil($json.indiciados) }}\",\n    \"ocorrencias\": \"{{ Math.ceil($json.ocorrencias) }}\"\n  }\n}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 2000
            }
          }
        }
      },

    {
      "parameters": {
        "jsCode": "// Renomeia colunas do Metabase para nomes padronizados\nconst items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n  return {\n    json: {\n      bairro: data['Bairro'] || data['bairro'] || '',\n      indiciados: data['Valores distintos de IDDesfecho'] || data['valores distintos de iddesfecho'] || 0,\n      protegidos: data['Soma de QtdProtegidos'] || data['soma de qtdprotegidos'] || 0,\n      ocorrencias: data['Contagem'] || data['contagem'] || 0\n    }\n  };\n});"
      },
      "id": "normalizar-colunas",
      "name": "Normalizar Colunas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.hubapi.com/cms/v3/hubdb/tables/224700702/rows/draft",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "1000"
            }
          ]
        }
      },
      "id": "get-hubdb-rows",
      "name": "HubDB: Buscar Linhas Existentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 600],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "HubSpot API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Recebe dados do Metabase (Input 1) e linhas do HubDB (Input 2)\n// Mapeia Bairro → rowId para fazer upsert\n\nconst metabaseData = $('Normalizar Colunas').all();\nconst hubdbResponse = $('HubDB: Buscar Linhas Existentes').all();\n\n// Extrair linhas do HubDB\nconst hubdbRows = hubdbResponse[0]?.json?.results || hubdbResponse[0]?.json?.objects || [];\n\n// Criar mapa: bairro (lowercase) → { rowId, colunas atuais }\nconst bairroToRowId = {};\nfor (const row of hubdbRows) {\n  const bairroValue = row.values?.bairro || row.values?.Bairro || '';\n  if (bairroValue) {\n    bairroToRowId[bairroValue.toString().toLowerCase().trim()] = row.id;\n  }\n}\n\n// Enriquecer cada item do Metabase com o rowId correspondente\nconst output = [];\nfor (const item of metabaseData) {\n  const bairro = (item.json.bairro || '').toString().toLowerCase().trim();\n  const rowId = bairroToRowId[bairro];\n\n  if (rowId) {\n    output.push({\n      json: {\n        rowId: rowId,\n        bairro: item.json.bairro,\n        indiciados: item.json.indiciados,\n        protegidos: item.json.protegidos,\n        ocorrencias: item.json.ocorrencias\n      }\n    });\n  }\n}\n\nreturn output;"
      },
      "id": "mapear-bairro-rowid",
      "name": "Mapear Bairro → Row ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, 400]
    },

def criar_local(session: requests.Session, props: Dict[str, Any]) -> Tuple[bool, str]:
    """
    Cria objeto 'Local' no HubSpot com as propriedades corretas.
    Retorna (ok, id_ou_erro).
    """
    url = f"https://api.hubapi.com/crm/v3/objects/{HUBSPOT_OBJECT}"  # HUBSPOT_OBJECT = "2-17828781"
    headers = {
        "Authorization": f"Bearer {HUBSPOT_TOKEN}",
        "Content-Type": "application/json"
    }

    # Mapeamento para schema do objeto Local
    properties = {
        "cep": props.get("cep"),
        "no_do_endereco": props.get("no_do_endereco"),
        "endereco": props.get("endereco"),  # Logradouro como principal
        "bairro": props.get("bairro"),
        "cidade_": props.get("cidade"),           # nome interno no HubSpot tem "_"
        "estado": props.get("estado"),
        "endereco_": props.get("logradouro"), # chave única / identificador
    }

    # Complemento se houver
    if props.get("complemento_de_endereco"):
        properties["complemento"] = props["complemento_de_endereco"]

    # Coordenadas se houver
    if props.get("latitude"):
        properties["latitude"] = props["latitude"]
    if props.get("longitude"):
        properties["longitude"] = props["longitude"]

    payload = {"properties": properties}

    try:
        resp = session.post(url, headers=headers, json=payload, timeout=HTTP_TIMEOUT)
        if resp.status_code in (200, 201):
            obj_id = (resp.json() or {}).get("id", "")
            log_kv("criar_local", status="ok", id=obj_id, props_enviadas=properties)
            return True, obj_id
        else:
            log_kv("criar_local", status="http_error", code=resp.status_code, text=resp.text[:200])
            return False, f"{resp.status_code}: {resp.text[:200]}"
    except Exception as e:
        log_kv("criar_local", status="ex", erro=str(e))
        return False, str(e)


def processamento_de_cep(cep: str) -> dict:
    if not cep:
        return {"cep": "", "cep_formatado": "", "estado": "", "cep_validado": 0, "fora_area": 0}

    cep_numerico = ''.join(filter(str.isdigit, str(cep)))
    if len(cep_numerico) != 8:
        return {"cep": cep, "cep_formatado": "", "estado": "", "cep_validado": 0, "fora_area": 0}

    cep_int = int(cep_numerico)
    estado = ""
    cidade = ""
    fora_area = 1  # assume fora da área, só libera se cair em SP/RJ/BH

    # cep_int = int(cep.replace("-", "").replace(".", "").strip())

    if cep_int in range(1000001, 6000000) or cep_int in range(8000000, 8500000):  # São Paulo - SP
      estado, cidade, fora_area = "SP", "São Paulo", 0

    elif cep_int in range(6000001, 6300000):  # Osasco - SP
      estado, cidade, fora_area = "SP", "Osasco", 0

    elif cep_int in range(6400001, 6500000):  # Barueri - SP
      estado, cidade, fora_area = "SP", "Barueri", 0

    elif cep_int in range(7000001, 7400000):  # Guarulhos - SP
      estado, cidade, fora_area = "SP", "Guarulhos", 0

    elif cep_int in range(9000001, 9300000):  # Santo André - SP
      estado, cidade, fora_area = "SP", "Santo André", 0

    elif cep_int in range(9500001, 9600000):  # São Caetano do Sul - SP
      estado, cidade, fora_area = "SP", "São Caetano do Sul", 0

    elif cep_int in range(9600001, 9900000):  # São Bernardo do Campo - SP
      estado, cidade, fora_area = "SP", "São Bernardo do Campo", 0

    elif cep_int in range(20000001, 23800000):  # Rio de Janeiro - RJ
      estado, cidade, fora_area = "RJ", "Rio de Janeiro", 0

    elif cep_int in range(24000001, 24400000):  # Niterói - RJ
      estado, cidade, fora_area = "RJ", "Niterói", 0

    elif cep_int in range(30000001, 32000000):  # Belo Horizonte - MG
      estado, cidade, fora_area = "MG", "Belo Horizonte", 0
      

    return {
        "cep": cep,
        "cep_formatado": f"{cep_numerico[:5]}-{cep_numerico[5:]}",
        "estado": estado,
        "cidade": cidade,
        "cep_validado": 1,
        "fora_area": fora_area
    }

def processamento_de_telefone(numero_raw: str, estado: str):
    """
    Processa e valida número de telefone (celular ou fixo) no Brasil.
    Retorna tupla:
    (formato+completo, formato+numerico, validado_cel (0|1), telefone_fixo (0|1))
    """

    # 1. Normalização: remover caracteres não numéricos
    numero = re.sub(r"\D", "", numero_raw or "")
    validacao = DEFAULT_VALIDADO
    fixos = DEFAULT_FIXOS

    # 2. Remove código do país se presente
    if numero.startswith("55") and len(numero) > 11:
        numero = numero[2:]

    # 3. Rejeitar sequência de dígitos iguais (no número completo)
    if len(numero) > 0 and len(set(numero)) == 1:
        return "", "", 0, 0

    # 4. Rejeitar sequência de dígitos iguais (apenas no número sem DDD)
    num_sem_ddd = ""
    if len(numero) in (10, 11):
        num_sem_ddd = numero[2:]
    elif len(numero) in (8, 9):
        num_sem_ddd = numero

    if len(num_sem_ddd) > 0 and len(set(num_sem_ddd)) == 1:
        return "", "", 0, 0

    # 5. Classificar telefone fixo/celular
    ddd = ""
    numero_formatado = ""
    prefixos_fixo = {"2", "3", "4", "5"}

    # Telefone fixo com DDD (10 dígitos e prefixo 2-5)
    if len(numero) == 10 and numero[2] in prefixos_fixo:
        ddd = numero[:2]
        numero_formatado = numero[2:]
        validacao = 1
        fixos = 1

    # Celular sem dígito 9 (10 dígitos)
    elif len(numero) == 10 and numero[2] not in prefixos_fixo:
        ddd = numero[:2]
        numero_formatado = f"9{numero[2:]}"
        validacao = 1

    # Celular com DDD (11 dígitos e começa com 9)
    elif len(numero) == 11 and numero[2] == "9":
        ddd = numero[:2]
        numero_formatado = numero[2:]
        validacao = 1

    # Celular sem DDD (9 dígitos, começa com 9)
    elif len(numero) == 9 and numero[0] == "9":
        ddd = DDD_POR_ESTADO.get(estado, "")
        numero_formatado = numero
        validacao = 1

    # Celular sem DDD e sem 9 (8 dígitos)
    elif len(numero) == 8 and numero[0] not in prefixos_fixo:
        ddd = DDD_POR_ESTADO.get(estado, "")
        numero_formatado = f"9{numero}"
        validacao = 1

    else:
        # Número inválido
        return "", "", 0, 0

    # 6. Validação extra: DDD e tamanho do número
    if not ddd or not (8 <= len(numero_formatado) <= 9):
        return "", "", 0, 0

    # 7. Formatação internacional e numérico completo
    formato_exibicao = f"{DEFAULT_COUNTRY_CODE}-{ddd}-{numero_formatado[:4]}-{numero_formatado[4:]}"
    formato_numerico = f"{DEFAULT_COUNTRY_CODE}{ddd}{numero_formatado}"

    return formato_exibicao, formato_numerico, validacao, fixos

def create_session() -> requests.Session:
    """Sessão HTTP com retry/backoff — robustez contra falhas transitórias."""
    s = requests.Session()
    retry = Retry(total=3, backoff_factor=0.3, status_forcelist=[500, 502, 503, 504])
    adapter = HTTPAdapter(max_retries=retry)
    s.mount("https://", adapter)
    s.mount("http://", adapter)
    return s

def hs_get_props(obj_type: str, obj_id: str, props: List[str]) -> Dict[str, Any]:
    url = f"https://api.hubapi.com/crm/v3/objects/{obj_type}/{obj_id}"
    r = requests.get(
        url,
        headers={"Authorization": f"Bearer {HUBSPOT_TOKEN}"},
        params={"properties": ",".join(props)},
        timeout=HTTP_TIMEOUT
    )
    r.raise_for_status()
    return r.json().get("properties", {}) or {}

def hs_patch_props(obj_type: str, obj_id: str, props_dict: Dict[str, Any]) -> Tuple[int, str]:
    url = f"https://api.hubapi.com/crm/v3/objects/{obj_type}/{obj_id}"
    r = requests.patch(
        url,
        json={"properties": props_dict},
        headers={"Authorization": f"Bearer {HUBSPOT_TOKEN}", "Content-Type": "application/json"},
        timeout=HTTP_TIMEOUT
    )
    return r.status_code, r.text

def normalizar_texto_vazio(valor):
    """
    Converte valores nulos, NoneType, ou não string em 'Não preenchido'.
    Garante consistência mesmo se vierem de JSON serializado do HubSpot.
    """
    if not isinstance(valor, str):
        return "Não preenchido"
    valor_str = valor.strip().lower()
    if valor_str in {"", "none", "null", "não preenchido", "nao preenchido"}:
        return "Não preenchido"
    return valor.strip()


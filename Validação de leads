def validate(n: Dict[str, Any]) -> List[str]:
    erros: List[str] = []

    # CEP obrigatório
    if not n.get("cep"):
        erros.append("cep_invalido")

    # Fora da área de atuação
    if n.get("cep_validado") == 1 and n.get("fora_area") == 1:
        erros.append("fora_area")

    # --- Validação do número de endereço ---
    num_endereco = str(n.get("no_de_endereco") or "").strip()
    if not num_endereco:
        erros.append("numero_endereco_invalido")
    elif not num_endereco.isdigit():
        erros.append("numero_endereco_invalido")
    elif int(num_endereco) >= 100000:
        erros.append("numero_endereco_invalido")

    # Telefone
    if not any([n.get("hs_whatsapp_phone_number"), n.get("telefone_do_lead"),
                n.get("telefone"), n.get("numero_de_telefone_fixo")]):
        erros.append("telefone_invalido")

    # Perfil obrigatório
    if not n.get("perfil_do_lead"):
        erros.append("perfil_vazio")

    # Origens obrigatórias
    #if not n.get("origem_macro"):
     #   erros.append("origem_macro_vazia")
    #if not n.get("origem_micro"):
    #    erros.append("origem_micro_vazia")

    # Form / UTM obrigatórios
    if not n.get("formulario___campanha"):
        erros.append("form_campanha_vazio")
    if not n.get("utm_source"):
        erros.append("utm_source_vazia")
    if not n.get("utm_medium"):
        erros.append("utm_medium_vazia")
    if not n.get("utm_campaign"):
        erros.append("utm_campaign_vazia")
    if not n.get("utm_content"):
        erros.append("utm_content_vazia")

    log_kv("validate", erros=";".join(erros) if erros else "")
    return erros


def associar_contato_a_negocio(session: requests.Session, deal_id: str, contact_id: str) -> Dict[str, Any]:
    if checar_associacao(session, deal_id, contact_id):
        return {"status": "info", "mensagem": f"Contato {contact_id} já associado ao negócio {deal_id}"}

    url = f"https://api.hubapi.com/crm/v3/objects/deals/{deal_id}/associations/contacts/{contact_id}/deal_to_contact"
    headers = {"Authorization": f"Bearer {HUBSPOT_TOKEN}", "Content-Type": "application/json"}
    try:
        resp = session.put(url, headers=headers, timeout=HTTP_TIMEOUT)
        if resp.status_code in (200, 201, 204):
            return {"status": "success", "mensagem": f"Contato {contact_id} associado ao negócio {deal_id}"}
        elif resp.status_code == 409:
            return {"status": "info", "mensagem": f"Contato {contact_id} já estava associado ao negócio {deal_id}"}
        else:
            return {"status": "error", "mensagem": f"Erro {resp.status_code}: {resp.text[:160]}"}
    except Exception as e:
        return {"status": "error", "mensagem": f"Exceção ao associar: {str(e)}"}
#============================================
# 14) ASSOCIAR NEGÓCIO BLOQUEADOR AO LEAD
#============================================
def associar_lead_a_negocio_v3(session, lead_id: str, deal_id: str,
                               lead_object_type: str = "leads",
                               association_type: str = "lead_to_primary_deal") -> dict:
    """
    Associa um Lead (custom object) a um Deal via Associations v3.
    - endpoint: POST /crm/v3/associations/{from}/{to}/batch/create
    - type: nome do tipo de associação (ex.: 'lead_to_primary_deal' ou 'lead_to_deal')
    Doc: Associations v3 batch create (type por nome).
    """
    url = f"https://api.hubapi.com/crm/v3/associations/{lead_object_type}/deals/batch/create"
    headers = {
        "Authorization": f"Bearer {HUBSPOT_TOKEN}",
        "Content-Type": "application/json",
    }
    payload = {
        "inputs": [
            {
                "from": {"id": str(lead_id)},
                "to":   {"id": str(deal_id)},
                "type": association_type,
            }
        ]
    }
    try:
        r = session.post(url, headers=headers, json=payload, timeout=HTTP_TIMEOUT)
        if r.status_code // 100 == 2:
            return {"status": "success",
                    "mensagem": f"Lead {lead_id} associado ao negócio {deal_id} (type='{association_type}')"}
        elif r.status_code == 409:
            return {"status": "info",
                    "mensagem": f"Associação já existia (type='{association_type}')"}
        else:
            return {"status": "error",
                    "mensagem": f"Erro {r.status_code}: {r.text[:300]}"}
    except Exception as e:
        return {"status": "error", "mensagem": f"Exceção: {e}"}

# ==========================================
# 15) ORQUESTRADOR (ÚNICO)
# ==========================================
def main(event: Dict[str, Any]) -> Dict[str, Any]:
    log_msgs: List[str] = []  # Acumula logs descritivos para salvar no lead

    # 0) Pré-checagens
    if not HUBSPOT_TOKEN:
        return {"outputFields": {
            "status_validacao": "erro_config",
            "msg": "Secret automacao_hubspot ausente",
            "log_de_erros_descritivo": "\n".join(log_msgs)
        }}

    # 1) Coletar
    ctx = collect_inputs(event)
    lead_id = ctx["recordId"]

    if lead_id:
        log_msgs.append("Lead coletado: OK")
    else:
        log_msgs.append("Lead coletado: FALHOU (recordId ausente)")

    if not lead_id:
        return {"outputFields": {
            "status_validacao": "erro_dado",
            "msg": "recordId ausente",
            "log_de_erros_descritivo": "\n".join(log_msgs)
        }}

    # 2) Criação da chave
    chave_do_local = criacao_chave(ctx["cep"], ctx["no_de_endereco"], ctx["complemento_de_endereco"])
    ctx["chave_do_local"] = chave_do_local
    if chave_do_local:
        log_msgs.append(f"Chave do local criada: {chave_do_local}")
    else:
        log_msgs.append("Chave do local: FALHOU")
    log_kv("criacao_chave", chave=chave_do_local)

    if not chave_do_local:
        return {"outputFields": {
            "status_validacao": "erro_dado",
            "msg": "chave_do_local ausente",
            "log_de_erros_descritivo": "\n".join(log_msgs)
        }}

    # 3) Validação
    erros: List[str] = validate(ctx)  # <-- garante inicialização
    if erros:
        log_msgs.append("Validação dos campos obrigatórios: FALHOU")
        for e in erros:
            log_msgs.append(f" → {e.replace('_', ' ')}")
    else:
        log_msgs.append("Validação dos campos obrigatórios: OK")

    primary = pick_primary_error(erros)
    status_final = "ok" if not erros else "erro_dado"

    # 4) Circuit-break
    if primary and is_circuit_break(primary):
        props_cb = {
            "log_de_erros": ERR_LABEL.get(primary, ERR_LABEL["erro_dados"]),
            "status_validacao": status_final,
            "last_validated_at": datetime.now(timezone.utc).isoformat(),
            "log_de_erros_descritivo": "\n".join(log_msgs),
        }
        log_msgs.append(f"Circuit-break acionado: {props_cb['log_de_erros']}")

        # Faz patch mínimo no HubSpot antes de encerrar
        hs_patch_props("leads", lead_id, props_cb)

        return {"outputFields": props_cb}

    # 5) Enriquecer endereço
    enr = enrich_address(ctx.get("cep") or "", ctx.get("no_de_endereco") or "")
    if enr.get("enriq_erro"):
        erros.append("reverso_falhou")
        log_msgs.append(f"Enriquecimento de endereço: FALHOU ({enr.get('enriq_erro')})")
        log_kv("enrich_error", motivo=enr.get("enriq_erro"), detalhe=enr.get("detalhe", ""))
    else:
        log_msgs.append("Enriquecimento de endereço: OK")
        logradouro = enr.get("logradouro", "")
        bairro     = (enr.get("bairro") or "").strip()
        cidade     = enr.get("localidade") or enr.get("cidade") or ""
        estado     = enr.get("uf") or enr.get("estado") or ""
        latitude   = enr.get("latitude") or ""
        longitude  = enr.get("longitude") or ""
        log_msgs.append(f" → {logradouro}, {bairro}, {cidade} - {estado}")
        if latitude and longitude:
            log_msgs.append(f" → Coordenadas: {latitude}, {longitude}")

    logradouro = enr.get("logradouro", "") if enr else ""
    bairro     = (enr.get("bairro") or "").strip() if enr else ""
    cidade     = enr.get("localidade") or enr.get("cidade") or "" if enr else ""
    estado     = enr.get("uf") or enr.get("estado") or "" if enr else ""
    latitude   = enr.get("latitude") or "" if enr else ""
    longitude  = enr.get("longitude") or "" if enr else ""
    endereco   = f"{logradouro}, {ctx.get('no_de_endereco')}" if logradouro and ctx.get("no_de_endereco") else (ctx.get("endereco") or "")

    # 6) Rotas/Asa
    rota = asa = ""
    if latitude and longitude and estado:
        r = rotas(latitude, longitude, estado)
        if r.get("erro_api") == 1:
            erros.append("erro_api_rota")
            log_msgs.append("Rotas/Asa: FALHA na API de rotas")
        else:
            rota, asa = r.get("rota", ""), r.get("asa", "")
            log_msgs.append(f"Rota atribuída: {rota or 'não encontrada'}")
            log_msgs.append(f"Asa atribuída: {asa or 'não encontrada'}")
    else:
        log_msgs.append("Rotas/Asa: não atribuídas (faltam dados de geolocalização)")

        # 7) LOCAL (buscar/criar)
    session = create_session()
    id_local = ctx.get("id_local_hubspot") or ""

    # só cria/busca local se o enriquecimento foi bem-sucedido
    enrich_ok = not enr.get("enriq_erro")

    if enrich_ok:
        if not id_local and ctx.get("chave_do_local"):
            id_local, end_local, err_local, multiplo = buscar_local_por_chave(session, ctx["chave_do_local"])
            if err_local:
                erros.append("erro_api_local")
                log_msgs.append(f"Busca de Local: FALHOU ({err_local})")

            if id_local == "0":
                log_msgs.append("Local não encontrado → criando novo local (enriquecimento OK)")
                props_local = {
                    "chave_do_objeto": ctx["chave_do_local"],
                    "cep": ctx.get("cep"),
                    "no_do_endereco": ctx.get("no_de_endereco"),
                    "complemento_de_endereco": ctx.get("complemento_de_endereco") or "sem complemento",
                    "logradouro": logradouro,
                    "endereco": ", ".join(f for f in [logradouro, ctx.get("no_de_endereco"), ctx.get("complemento_de_endereco"), bairro, cidade] if f),
                    "cidade": cidade,
                    "estado": estado,
                    "bairro": bairro,
                }
                ok, res_local = criar_local(session, props_local)
                if ok:
                    id_local = res_local
                    log_msgs.append(f"Local criado com sucesso: {id_local}")
                    log_kv("criar_local", novo_id=id_local, chave=ctx["chave_do_local"])
                else:
                    erros.append("erro_criar_local")
                    log_msgs.append(f"Criação de Local: FALHOU ({res_local})")
                    log_kv("criar_local", status="falha", detalhe=res_local)

            ctx["id_local_hubspot"] = id_local
    else:
        log_msgs.append("Criação de Local: ignorada (enriquecimento falhou)")
        ctx["id_local_hubspot"] = None


        # 8) LEADS DUPLICADOS
    duplicado_info = {}
    if ctx.get("id_local_hubspot") and lead_id:
        duplicado, err_dup = buscar_lead_duplicado(session, ctx["id_local_hubspot"], lead_id)
        if err_dup:
            erros.append("erro_api_lead_dup")
            log_kv("lead_duplicado", status="erro", detalhe=err_dup)
            log_msgs.append(f"Leads duplicados: ERRO ao verificar ({err_dup})")
        elif duplicado:
            duplicado_info = duplicado

            # buscar nome do owner
            owners = get_owners(session)
            owner_id = duplicado.get("owner_id", "")
            owner_nome = owners.get(owner_id, "")
            duplicado_info["owner_nome"] = owner_nome

            if duplicado["fase"] and duplicado["fase"] != FASE_PERDIDO:
                erros.append("erro_lead_duplicado")
                log_kv("lead_duplicado", status="ativo", duplicado_id=duplicado["id"], owner=owner_id, owner_nome=owner_nome)
                log_msgs.append(
                    f"Leads duplicados: encontrado lead ATIVO (ID {duplicado['id']}, owner {owner_nome or owner_id})"
                )
            else:
                log_kv("lead_duplicado", status="perdido", duplicado_id=duplicado["id"], owner=owner_id, owner_nome=owner_nome)
                log_msgs.append(
                    f"Leads duplicados: encontrado lead PERDIDO/CANCELADO (ID {duplicado['id']}, owner {owner_nome or owner_id})"
                )
        else:
            log_kv("lead_duplicado", status="nao_encontrado")
            log_msgs.append("Leads duplicados: nenhum encontrado para este local")


    # 9) NEGÓCIOS
    negocios_info = {}
    if ctx.get("id_local_hubspot"):
        negocios_ids = buscar_negocios_associados(session, ctx["id_local_hubspot"])
        if negocios_ids:
            log_msgs.append(f"Negócios associados ao local: {len(negocios_ids)}")
        else:
            log_msgs.append("Negócios associados ao local: nenhum encontrado")

        event["inputFields"]["negocios_associados"] = json.dumps(negocios_ids)
        negocios_info = validar_negocios_pelo_pipeline_fase(event)

        if negocios_info.get("local_trabalhavel") == 0:
            erros.append("negocio_ativo")
            negocio_bloqueador_id = negocios_info.get("negocio_bloqueador_id")
            contact_id = ctx.get("contact_id")  # precisa garantir que esse campo exista em collect_inputs
            if negocio_bloqueador_id and contact_id:
                resultado_assoc = associar_contato_a_negocio(session, negocio_bloqueador_id, contact_id)
                log_msgs.append(f"Contato associado ao negócio ativo: {resultado_assoc}")
                log_kv("associar_contato", resultado=resultado_assoc)
                    # Associar o negócio ativo ao próprio lead
            if negocio_bloqueador_id and lead_id:
                res_lead = associar_lead_a_negocio_v3(session, lead_id, negocio_bloqueador_id,
                lead_object_type=OBJETO_LEAD,
                association_type="lead_to_primary_deal")
                log_msgs.append(f"Negócio ativo associado ao lead: {res_lead}")
                log_kv("associar_lead_v3", resultado=res_lead)



        # 10) Montar props finais
    final_primary = pick_primary_error(erros)
    final_label = ERR_LABEL.get(final_primary, "") if final_primary else ""
    status_final = "ok" if not final_primary else "erro_dado"

    props = {
        "telefone_do_lead": ctx.get("telefone_do_lead"),
        "cep": ctx.get("cep"),
        "bairro": bairro,
        "cidade": cidade,
        "estado": estado,
        "latitude": latitude,
        "longitude": longitude,
        "endereco": endereco,
        "rota_do_lead": rota,
        "asa_do_lead": asa,
        "utm_source": ctx.get("utm_source"),
        "utm_medium": ctx.get("utm_medium"),
        "utm_campaign": ctx.get("utm_campaign"),
        "utm_content": ctx.get("utm_content"),
        "id_local_hubspot": id_local,
        "log_de_erros": final_label,
        "log_de_erros_descritivo": "\n".join(log_msgs)
    }

    # garantir que não apaga o lead stage atual
    lead_stage_atual = ctx.get("hs_pipeline_stage")
    if lead_stage_atual and lead_stage_atual.strip():
        props["hs_pipeline_stage"] = lead_stage_atual
    # só forçar owner se tiver duplicado e realmente houver owner definido
    owner_id_dup = duplicado_info.get("owner_id")
    if owner_id_dup and owner_id_dup.strip():
        props["hubspot_owner_id"] = owner_id_dup
    # Debug
    log_kv("patch_preview", props_count=len(props), status_prev=status_final, log_de_erros=final_label, negocios_info=negocios_info)
        # PATCH no HubSpot
    st, txt = hs_patch_props("leads", lead_id, props)
    log_kv("patch_result", status_code=st, body_preview=txt[:160])

    # Montar flags de erro específicas
    erros_set = set(erros or [])
    flags = {
        "erro_cep": 1 if "cep_invalido" in erros_set else 0,
        "erro_numero_endereco": 1 if "numero_endereco_invalido" in erros_set else 0,
        "erro_telefone": 1 if "telefone_invalido" in erros_set else 0,
        "erro_utm": 1 if any(e in erros_set for e in [
            "utm_source_vazia", "utm_medium_vazia", "utm_campaign_vazia", "utm_content_vazia"
        ]) else 0
    }

    if st // 100 == 2:
      return {"outputFields": {
        "status_validacao": status_final,
        "log_de_erros": final_label,
        "log_de_erros_descritivo": "\n".join(log_msgs),
        "owner_nome_duplicado": duplicado_info.get("owner_nome", ""),
        "last_validated_at": datetime.now(timezone.utc).isoformat(),
        "erro_enriquecimento": 1 if enr.get("enriq_erro") else 0,
        "local_criado": 1 if ctx.get("id_local_hubspot") else 0,

        **flags
    }}
    else:
      return {"outputFields": {
        "status_validacao": "erro_hubspot",
        "msg": f"PATCH {st}: {txt[:200]}",
        "log_de_erros_descritivo": "\n".join(log_msgs),
        "last_validated_at": datetime.now(timezone.utc).isoformat(),

        # também replicar aqui para consistência
        "erro_enriquecimento": 1 if enr.get("enriq_erro") else 0,
        "local_criado": 1 if ctx.get("id_local_hubspot") else 0,

        **flags
    }}

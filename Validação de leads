def buscar_local_por_chave(session: requests.Session, chave_local: str) -> Tuple[str, str, Optional[str], int]:
    """Busca objeto 'Local' por PROPERTY_KEY; retorna (objeto_id, endereco, error_message, multiplo_encontrado flag)."""
    headers = {"Authorization": f"Bearer {HUBSPOT_TOKEN}", "Content-Type": "application/json"}
    search_url = f"https://api.hubapi.com/crm/v3/objects/{HUBSPOT_OBJECT}/search"
    payload = {
        "filterGroups": [{
            "filters": [{"propertyName": PROPERTY_KEY, "operator": "EQ", "value": chave_local}]
        }],
        "properties": ["hs_object_id", "endereco"]
    }
    try:
        resp = session.post(search_url, headers=headers, json=payload, timeout=HTTP_TIMEOUT)
        resp.raise_for_status()
        data = resp.json()
        results = data.get("results", [])
        multiplo_encontrado = 1 if len(results) > 1 else 0
        if results:
            primeiro = results[0]
            objeto_id = str(primeiro.get("id", "")) or "0"
            endereco = primeiro.get("properties", {}).get("endereco", "")
            log_kv("buscar_local", chave=chave_local, objeto_id=objeto_id, endereco=endereco, multiplo=multiplo_encontrado)
            return objeto_id, endereco, None, multiplo_encontrado
        log_kv("buscar_local", chave=chave_local, objeto_id="0", endereco="", multiplo=0)
        return "0", "", None, 0
    except requests.RequestException as e:
        logger.error("Erro ao buscar objeto Local: %s", e)
        return "0", "", str(e), 0


def parse_hubspot_timestamp(value: Optional[str]) -> Optional[datetime]:
    """Converte timestamps do HubSpot (ms ou ISO8601) em datetime UTC."""
    if not value:
        return None
    try:
        if isinstance(value, str) and value.isdigit():
            return datetime.fromtimestamp(int(value) / 1000, tz=timezone.utc)
        return datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except Exception:
        return None


def get_owners(session: requests.Session) -> Dict[str, str]:
    """Obtém todos os owners do portal HubSpot."""
    url = "https://api.hubapi.com/crm/v3/owners"
    headers = {"Authorization": f"Bearer {HUBSPOT_TOKEN}"}
    owners = {}
    try:
        next_url = url
        while next_url:
            resp = session.get(next_url, headers=headers, timeout=HTTP_TIMEOUT)
            resp.raise_for_status()
            data = resp.json()
            for owner in data.get('results', []):
                owner_id = str(owner.get('id', ''))
                owner_nome = f"{owner.get('firstName', '')} {owner.get('lastName', '')}".strip()
                owners[owner_id] = owner_nome
            next_url = data.get('paging', {}).get('next', {}).get('link')
    except requests.RequestException as e:
        logger.error("Erro ao obter proprietários: %s", e)
    return owners


def get_deal_info(session: requests.Session, deal_id: str) -> Dict[str, Any]:
    """Consulta dados essenciais de um negócio (deal) no HubSpot."""
    url = (
        f"https://api.hubapi.com/crm/v3/objects/deals/{deal_id}"
        "?properties=dealstage,pipeline,hubspot_owner_id,situacao,notes_last_updated,createdate"
    )
    headers = {"Authorization": f"Bearer {HUBSPOT_TOKEN}"}
    try:
        resp = session.get(url, headers=headers, timeout=HTTP_TIMEOUT)
        resp.raise_for_status()
        props = resp.json().get('properties', {}) or {}
        return {
            "deal_id": deal_id,
            "pipeline": props.get("pipeline", ""),
            "dealstage": props.get("dealstage", ""),
            "owner_id": str(props.get("hubspot_owner_id", "")),
            "situacao": (props.get(PROP_SITUACAO, "") or "").strip(),
            "notes_last_updated": props.get("notes_last_updated", ""),
            "createdate": props.get("createdate", "")
        }
    except requests.RequestException as e:
        logger.warning("Erro ao obter deal %s: %s", deal_id, e)
        return {
            "deal_id": deal_id, "pipeline": "", "dealstage": "", "owner_id": "",
            "situacao": "", "notes_last_updated": "", "createdate": ""
        }


def houve_atividade_recente(notes_last_updated: str, hoje_utc: datetime) -> bool:
    """Verifica se houve atividade recente (por notas) dentro da janela limite."""
    dt = parse_hubspot_timestamp(notes_last_updated)
    if not dt:
        return False
    return (hoje_utc - dt).days < LIMITE_DIAS_ATIVIDADE


def criado_recente(createdate: str, hoje_utc: datetime) -> Optional[bool]:
    """Verifica se o negócio foi criado recentemente (dentro da janela limite)."""
    dt = parse_hubspot_timestamp(createdate)
    if not dt:
        return None
    return (hoje_utc - dt).days < LIMITE_DIAS_ATIVIDADE

def validar_negocios_pelo_pipeline_fase(event: Dict[str, Any]) -> Dict[str, Any]:
    """Valida negócios vinculados ao local e determina se o local é 'trabalhável'."""
    input_fields = event.get("inputFields", {})
    negocios_raw = input_fields.get("negocios_associados", "[]")

    # Normaliza entrada
    if isinstance(negocios_raw, str):
        try:
            negocios_associados = json.loads(negocios_raw)
        except Exception:
            negocios_associados = [negocios_raw] if negocios_raw.isdigit() else []
    elif isinstance(negocios_raw, int):
        negocios_associados = [str(negocios_raw)]
    elif isinstance(negocios_raw, list):
        negocios_associados = [str(n) for n in negocios_raw if n]
    else:
        negocios_associados = []

    # Nenhum negócio → local liberado
    if not negocios_associados:
        return {
            "api_status": "success",
            "local_trabalhavel": 1,
            "log_negocios": [],
            "erro_api": 0,
            "qtd_negocios_analisados": 0,
            "tem_negocio_boas_vindas": 0,
            "tem_negocio_cs": 0,
            "motivo": "Sem negócios associados para analisar."
        }

    session = create_session()
    owners = get_owners(session)
    hoje = datetime.now(timezone.utc)

    log_negocios: List[Dict[str, Any]] = []
    tem_negocio_boas_vindas = 0
    tem_negocio_cs = 0
    local_trabalhavel = 1
    bloqueador_info = bloqueador_id = bloqueador_owner_id = bloqueador_owner_nome = None
    motivo_bloqueio = ""
    erro_api = 0

    for deal_id in negocios_associados:
        info = get_deal_info(session, deal_id)
        pipeline, stage, owner_id = info["pipeline"], info["dealstage"], info["owner_id"]
        owner_nome = owners.get(owner_id, "")
        situacao = info.get("situacao", "")
        notes_last_updated = info.get("notes_last_updated", "")
        createdate = info.get("createdate", "")

        atividade_recente = houve_atividade_recente(notes_last_updated, hoje)
        criado_rec = criado_recente(createdate, hoje)

        log_item = {
            "negocio_id": deal_id,
            "pipeline_id": pipeline,
            "fase_negocio": stage,
            "proprietario_id": owner_id,
            "proprietario_nome": owner_nome,
            "situacao": situacao,
            "notes_last_updated": notes_last_updated,
            "createdate": createdate,
            "atividade_recente": 1 if atividade_recente else 0,
            "criado_recentemente": (1 if criado_rec is True else (0 if criado_rec is False else None))
        }
        log_negocios.append(log_item)

        if not pipeline and not stage and not owner_id:
            erro_api = 1

        def esta_recente() -> bool:
            if atividade_recente:
                return True
            if not notes_last_updated and criado_rec is True:
                return True
            return False

        # ============================================================
        # 1. Pipeline bloqueador direto — Renovação
        # ============================================================
        if pipeline == "706455157":  # Renovação
            local_trabalhavel = 0
            motivo_bloqueio = "Renovação ativa (bloqueio direto)"
            bloqueador_info, bloqueador_id, bloqueador_owner_id, bloqueador_owner_nome = (
                log_item, deal_id, owner_id, owner_nome
            )
            break

        # ============================================================
        # 2. Pipeline Boas-Vindas
        # ============================================================
        if pipeline == PIPELINE_BOAS_VINDAS:
            if stage == "1074040071":  # Cliente cancelado (Boas-Vindas)
                continue
            tem_negocio_boas_vindas, local_trabalhavel = 1, 0
            motivo_bloqueio = "Boas-vindas ativo"
            bloqueador_info, bloqueador_id, bloqueador_owner_id, bloqueador_owner_nome = (
                log_item, deal_id, owner_id, owner_nome
            )
            break

        # ============================================================
        # 3. Pipeline CS
        # ============================================================
        if pipeline == PIPELINE_CS:
            if stage == "143668810":  # Negócio Perdido (Sucesso do Cliente)
                continue
            tem_negocio_cs, local_trabalhavel = 1, 0
            motivo_bloqueio = "Sucesso do Cliente ativo"
            bloqueador_info, bloqueador_id, bloqueador_owner_id, bloqueador_owner_nome = (
                log_item, deal_id, owner_id, owner_nome
            )
            break

        # ============================================================
        # 4. Pipeline Pagamentos Compartilhados
        # ============================================================
        if pipeline == "718915418":  # Pagamentos Compartilhados
            if stage == "1048951857":  # Perdido
                continue
            elif stage == "1048951856":  # Concluído
                if situacao == "Ativo" or esta_recente():
                    local_trabalhavel = 0
                    motivo_bloqueio = "Pagamentos Compartilhados concluído recente (<30 dias)"
                    bloqueador_info, bloqueador_id, bloqueador_owner_id, bloqueador_owner_nome = (
                        log_item, deal_id, owner_id, owner_nome
                    )
                    break
                else:
                    continue
            elif esta_recente():
                local_trabalhavel = 0
                motivo_bloqueio = "Pagamentos Compartilhados ativo recente (<30 dias)"
                bloqueador_info, bloqueador_id, bloqueador_owner_id, bloqueador_owner_nome = (
                    log_item, deal_id, owner_id, owner_nome
                )
                break
            else:
                continue

        # ============================================================
        # 5. Pipeline Executivos 2.0
        # ============================================================
        exec_cfg = PIPELINES_VALIDOS["executivos_vendas_2_0"]
        if pipeline == exec_cfg["pipeline_id"]:
            if stage == exec_cfg["fase_perdido"]:
                continue
            elif stage == exec_cfg["fase_concluido"]:
                if situacao == "Cancelado":
                    continue
                local_trabalhavel = 0
                motivo_bloqueio = "Executivos 2.0 concluído ativo"
                bloqueador_info, bloqueador_id, bloqueador_owner_id, bloqueador_owner_nome = (
                    log_item, deal_id, owner_id, owner_nome
                )
                break
            elif esta_recente():
                local_trabalhavel = 0
                motivo_bloqueio = "Executivos 2.0 ativo recente (<30 dias)"
                bloqueador_info, bloqueador_id, bloqueador_owner_id, bloqueador_owner_nome = (
                    log_item, deal_id, owner_id, owner_nome
                )
                break
            else:
                continue

        # ============================================================
        # 6. Pipeline Parceria — Qualificação
        # ============================================================
        parceria_cfg = PIPELINES_VALIDOS["parceria_qualificacao"]
        if pipeline == parceria_cfg["pipeline_id"]:
            if stage == parceria_cfg["fase_perdido"]:
                continue
            elif esta_recente():
                local_trabalhavel = 0
                motivo_bloqueio = "Parceria/Qualificação ativo recente (<30 dias)"
                bloqueador_info, bloqueador_id, bloqueador_owner_id, bloqueador_owner_nome = (
                    log_item, deal_id, owner_id, owner_nome
                )
                break
            else:
                continue

    # ============================================================
    # Resultado final
    # ============================================================
    if local_trabalhavel == 0 and not motivo_bloqueio:
        motivo_bloqueio = "Bloqueio identificado sem motivo explícito"

    base = {
        "api_status": "success",
        "log_negocios": log_negocios,
        "erro_api": erro_api,
        "qtd_negocios_analisados": len(negocios_associados),
        "tem_negocio_boas_vindas": tem_negocio_boas_vindas,
        "tem_negocio_cs": tem_negocio_cs,
        "local_trabalhavel": local_trabalhavel,
        "motivo_bloqueio": motivo_bloqueio
    }

    if local_trabalhavel == 0:
        neg_id = bloqueador_info.get("negocio_id") if bloqueador_info else bloqueador_id
        neg_pipeline = bloqueador_info.get("pipeline_id") if bloqueador_info else "?"
        neg_stage = bloqueador_info.get("fase_negocio") if bloqueador_info else "?"
        neg_owner_nome = bloqueador_info.get("proprietario_nome") if bloqueador_info else bloqueador_owner_nome

        base.update({
            "negocio_bloqueador": bloqueador_info,
            "negocio_bloqueador_id": neg_id,
            "proprietario_bloqueador_id": bloqueador_owner_id,
            "proprietario_bloqueador_nome": neg_owner_nome,
            "motivo": f"Bloqueado pelo negócio {neg_id} ({neg_owner_nome}) no pipeline {neg_pipeline}, fase {neg_stage} — {motivo_bloqueio}"
        })
    else:
        base.update({
            "motivo": "Liberado: sem bloqueios (perdido/cancelado ou não recente pela regra de 30 dias)."
        })

    log_kv(
        "validar_negocios",
        local_trabalhavel=local_trabalhavel,
        qtd_negocios_analisados=len(negocios_associados),
        motivo_bloqueio=motivo_bloqueio
    )
    return base




def buscar_lead_duplicado(session: requests.Session, id_local: str, id_lead_atual: str) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
    """
    Busca outro lead (diferente do atual) com o mesmo id_local_hubspot.
    Retorna (duplicado, erro).
    duplicado = {'id': ..., 'fase': ..., 'owner_id': ...} ou None
    """
    url = f"https://api.hubapi.com/crm/v3/objects/leads/search"
    headers = {
        "Authorization": f"Bearer {HUBSPOT_TOKEN}",
        "Content-Type": "application/json"
    }
    payload = {
        "filterGroups": [{
            "filters": [{
                "propertyName": "id_local_hubspot",
                "operator": "EQ",
                "value": id_local
            }]
        }],
        "properties": ["hs_object_id", "hs_pipeline_stage", "hubspot_owner_id"],
        "limit": 5
    }

    try:
        resp = session.post(url, headers=headers, json=payload, timeout=HTTP_TIMEOUT)
        resp.raise_for_status()
        results = resp.json().get("results", [])

        for lead in results:
            lead_id = str(lead.get("id", ""))
            if lead_id != str(id_lead_atual):
                props = lead.get("properties", {})
                owner_id = props.get("hubspot_owner_id", "")

                # fallback: busca completa se o owner vier vazio
                if not owner_id:
                    try:
                        url_get = f"https://api.hubapi.com/crm/v3/objects/leads/{lead_id}?properties=hubspot_owner_id,hs_pipeline_stage"
                        resp_get = session.get(url_get, headers=headers, timeout=HTTP_TIMEOUT)
                        if resp_get.status_code == 200:
                            props_get = resp_get.json().get("properties", {})
                            owner_id = props_get.get("hubspot_owner_id", "") or ""
                    except Exception as inner_e:
                        log_kv("lead_dup_owner_fallback_erro", erro=str(inner_e))

                return {
                    "id": lead_id,
                    "fase": props.get("hs_pipeline_stage", ""),
                    "owner_id": owner_id
                }, None

        return None, None

    except Exception as e:
        return None, str(e)


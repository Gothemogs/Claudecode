# ================================
def rotas(latitude: str, longitude: str, estado: str) -> Dict[str, Any]:
    """Consulta a Lambda de rota e mapeia para 'asa' via dicionário local. Loga resultado."""
    try:
        lat = float(latitude)
        lng = float(longitude)
        uf = str(estado or "").strip().upper()
    except Exception:
        return {"erro_api": 1, "rota": "", "asa": ""}

    try:
        payload = {'latitude': lat, 'longitude': lng, 'uf': uf}
        headers = {'Content-Type': 'application/json'}
        r = requests.post(API_LAT_LONG_UF_PARA_ROTA_E_ASA, json=payload, headers=headers, timeout=HTTP_TIMEOUT)

        if r.status_code // 100 != 2:
            log_kv("rotas", status="http_error", code=r.status_code, text=r.text[:160])
            return {"erro_api": 1, "rota": "", "asa": ""}

        # ✅ Agora o retorno é texto simples (ex: "Copacabana 1 + Leme"), não JSON
        try:
            data = r.json()
            if isinstance(data, dict) and "rota" in data:
                rota = data.get("rota", "")
            else:
                rota = str(data).strip()
        except ValueError:
            # Caso o retorno não seja JSON (texto puro)
            rota = r.text.strip()

        asa = dicionario_asa.get(rota, "")
        log_kv("rotas", status="ok", rota=rota, asa=asa)
        return {"erro_api": 0, "rota": rota, "asa": asa}

    except Exception as e:
        log_kv("rotas", status="ex", erro=str(e))
        return {"erro_api": 1, "rota": "", "asa": ""}



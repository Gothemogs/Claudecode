def pick_primary_error(erros: List[str]) -> str:
    """Escolhe a causa raiz seguindo a PRIORIDADE definida."""
    s = set(erros or [])
    for code in PRIMARY_ERROR_ORDER:
        if code in s:
            return code
    return "erro_dados" if s else ""

def is_circuit_break(code: str) -> bool:
    """Circuit-break somente para CEP, nº e telefone (como você pediu)."""
    return code in {"cep_invalido", "numero_endereco_invalido", "telefone_invalido"}

